# Environnement virtuel créé par uv (ou venv/virtualenv)
.venv/
venv/
ENV/

# Fichiers et dossiers de cache Python
__pycache__/
*.py[cod]
*$py.class

# Fichiers de configuration IDE / Éditeurs
.vscode/
.idea/
*.swp
*.swo

# Fichiers d'environnement (si vous stockez des clés API/secrets)
.env
.env.local

# Fichiers de distribution / build (si vous créez un package)
dist/
build/
*.egg-info/